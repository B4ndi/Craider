  "pairlists": [
    {
      "method": "StaticPairList"
    },
    {
      "method": "VolumePairList",
      "number_assets": 10,
      "sort_key": "quoteVolume",
      "lookback_days": 30,
      "refresh_period": 86400
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 30
    }
  ],
  "bot_name": "craider",
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  },
  "strategy": "Craider"
