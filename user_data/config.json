{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 8,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "trading_mode": "spot",
  "timeframe": "4h",
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT",
      "XRP/USDT",
      "BCH/USDT",
      "LTC/USDT",
      "BNB/USDT",
      "XTZ/USDT",
      "XLM/USDT",
      "ADA/USDT",
      "TRX/USDT",
      "LINK/USDT",
      "ETC/USDT",
      "NEO/USDT",
      "DASH/USDT",
      "ATOM/USDT",
      "IOTA/USDT",
      "ZEC/USDT",
      "DOT/USDT",
      "UNI/USDT",
      "THETA/USDT",
      "VET/USDT",
      "FIL/USDT",
      "SOL/USDT",
      "AVAX/USDT",
      "DOGE/USDT",
      "NEAR/USDT",
      "ALGO/USDT",
      "ICP/USDT",
      "AXS/USDT",
      "SAND/USDT",
      "MANA/USDT",
      "EGLD/USDT",
